# Copy this file to .env and fill in your own values:
#   cp example.env .env        (Windows: copy example.env .env)
#
# .env is gitignored — never commit real credentials or secrets.

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────

# Option A — a full connection string. Takes precedence over the individual
# DB_* / PG* variables *for the application*.
#
#   ⚠️  The test suite does NOT read DATABASE_URL. It resolves its own
#       connection settings from DB_* / PG* only. If you use DATABASE_URL,
#       set the DB_* variables below to match, or `npm test` will connect
#       somewhere else. See TESTING.md.
#
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Option B — individual settings (used by both the app and the tests).

# ⚠️  DB_USER is the most common setup mistake.
#     Homebrew and Postgres.app do NOT create a role named `postgres` — they
#     create one named after your OS username. Run `whoami` and use that.
#     Leaving this blank falls back to `postgres` and every database-backed
#     test fails with: role "postgres" does not exist
DB_USER=your_postgres_username

DB_HOST=localhost

# The application database. `npm run setup-db` creates it if it does not exist,
# so you do not need to create it by hand.
DB_NAME=soda_soft_drink_store

# Leave blank if your local server uses trust auth (Postgres.app default).
DB_PASSWORD=your_password

DB_PORT=5432

# Legacy aliases still supported by config.js. Only needed if you prefer the
# standard libpq names — the DB_* variables above take precedence.
# PGUSER=your_postgres_username
# PGHOST=localhost
# PGDATABASE=soda_soft_drink_store
# PGPASSWORD=your_password
# PGPORT=5432

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────

# HTTP port the API listens on. config.js defaults to 4001 when unset.
PORT=4001

# Secret used to sign JWTs. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your_secure_jwt_secret_key

# How long issued tokens stay valid (default: 1d).
JWT_EXPIRES_IN=1d

# Allowed frontend origin(s), comma-separated (default: http://localhost:3000).
CORS_ORIGIN=http://localhost:3000
