  "version": "1.0.0",
  "description": "Codecademy E-Commerce REST API for the Soda Soft Drink Store",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "setup-db": "node setupDatabase.js",
    "seed": "node seed.js",
    "test": "node --require dotenv/config --test",
    "lint": "eslint .",
